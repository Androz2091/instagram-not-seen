{
    "manifest_version": 3,
    "name": "Instagram Not Seen",
    "version": "2.0.0",
    "description": "Watch Instagram stories without showing up in the viewer list.",
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://www.instagram.com/*"],
            "js": ["inject.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.instagram.com/*"],
            "js": ["bridge.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/get_started16.png",
            "32": "images/get_started32.png",
            "48": "images/get_started48.png",
            "128": "images/get_started128.png"
        }
    },
    "icons": {
        "16": "images/get_started16.png",
        "32": "images/get_started32.png",
        "48": "images/get_started48.png",
        "128": "images/get_started128.png"
    }
}
